# Copy to .env and fill in. .env is gitignored.
#
# SECURITY, resolved 2026-08-23: a FRED key was committed to this repository's
# history in commit 6ca8476. Untracking the file in f778738 did NOT remediate
# it -- `git show 6ca8476:backend/.env` still returns the value. The key has
# since been revoked and reissued, so the string left in history is inert.
# Removing a secret from the working tree is not revocation.

# Federal Reserve Economic Data. Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Used for ICE BofA option-adjusted spread indices (the cohort benchmark).
# Read at BUILD time only, by scripts/build_site_data.py. Never reaches a browser.
FRED_API_KEY=

# Tiingo. Free tier: https://www.tiingo.com/
# Used for delisted-firm price history, which no other free source retains.
# METERED: 500 unique symbols per CALENDAR MONTH, 50 requests/hour, 1000/day.
# The monthly symbol cap does not reset per run. src/data/budget.py enforces it
# with a hard stop and a committed ledger; a cached symbol costs nothing.
TIINGO_API_KEY=

# Optional. Contact address sent to SEC EDGAR, which asks for one in the
# User-Agent. Defaults to a generic string if unset.
SEC_USER_AGENT=
