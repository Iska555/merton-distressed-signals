# Copy to backend/.env and fill in. backend/.env is gitignored - never commit it.

# Federal Reserve Economic Data (FRED) API key.
# Free, register at: https://fred.stlouisfed.org/docs/api/api_key.html
# Used for: Treasury yield curve (DGS1/DGS10) and ICE BofA corporate OAS indices.
# NOTE: FRED serves ICE BofA OAS series on a ROLLING 3-YEAR WINDOW only
#       (verified 2026-08-19). Treasury series carry full history.
FRED_API_KEY=your_fred_api_key_here

# Optional. Log verbosity for the FastAPI service.
LOG_LEVEL=INFO
